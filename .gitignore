# Generated inference outputs (regenerate locally)
inference_results/


# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/

# Archives produced by pipelines
*.zip
!training_datasets/combined_training_dataset.zip

# Reproducible per-layout dataset intermediates
training_datasets/combined_training_dataset/
training_datasets/*/dataset_output/
training_datasets/*/training_dataset/
training_datasets/*/training_dataset.zip

# B6.1 localization arrays are reproducible and large. Commit only the compact
# result summary and documentation under results/b6_localization_dataset/.
training_datasets/b6_localization_dataset/
training_datasets/b6_localization_dataset.zip

# Logs and local validation artifacts
validation_*.log
training_metrics.json

# B2 checkpoints are reproducible but too large for normal source review.
# Commit the aggregate/run JSON and Markdown reports after a phase run.
results/b2_baselines/checkpoints/

# B3 search/confirmation checkpoints are saved in Drive and identified by hash.
results/b3_optimization/**/checkpoints/

# B4 candidate checkpoints remain resume-safe in Drive and are hash-identified.
results/b4_architecture/checkpoints/

# B6.2 checkpoints are retained in Drive and identified by SHA-256. The small
# run JSON, aggregate summary, report, and presentation update are committed
# only after the official three-seed GPU run is accepted.
results/b6_multitask_unet/seed_*/best.pth
results/b6_multitask_unet/seed_*/last.pt

# B7 Drive runs export detailed per-layout components, exact candidates, and
# diagnostic plots. Commit only the compact accepted summary/report after the
# official run; preserve the complete result ZIP in Drive.
results/b7_full_layout/layouts/
results/b7_full_layout/layout_cache/
results/b7_full_layout/scan_cache/
results/b7_full_layout/validation_policy_selection.json
results/b7_full_layout/validation_summary.json
results/b7_full_layout/development_confirmation_summary.json
results/b7_full_layout/*.png

